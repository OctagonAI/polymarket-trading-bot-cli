# ── Required ──────────────────────────────────────────────────────────

# Polymarket market data (Gamma / CLOB / Data APIs) is PUBLIC — reads need no
# credentials, so there is no exchange key to set here. Order placement is not
# implemented yet; when it lands it will use a Polygon wallet signature rather
# than an API key. See the Optional section for the read-only wallet address.

# LLM provider (at least one required)
# ⚠️  The bot defaults to GPT-5.4 (OpenAI). If you use a different provider,
#    change the default model here or via /model in the TUI.
DEFAULT_MODEL=gpt-5.4
# Examples for other providers:
#   DEFAULT_MODEL=claude-sonnet-4-20250514
#   DEFAULT_MODEL=gemini-2.5-pro
#   DEFAULT_MODEL=grok-3
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key
XAI_API_KEY=your-xai-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Octagon AI — required for deep research (/analyze, /watch, /scan) AND for
# the Octagon-backed discovery commands: /search, /search edge, /similar,
# /events, /trust, /report. Without a key, /search and /search edge fall back
# to the local SQLite cache; the others require the key.
# Get one at https://app.octagonai.co
OCTAGON_API_KEY=your-octagon-api-key

# ── Optional ─────────────────────────────────────────────────────────

# Your Polygon wallet address (0x…). Read-only: it is used to look up your
# positions and portfolio value via the Data API. No private key involved.
# POLYMARKET_WALLET_ADDRESS=0x...

# Point the three Polymarket services at their staging hosts instead of prod.
# Unverified — the documented staging hostnames do not currently resolve.
# POLYMARKET_USE_STAGING=false

# Override an individual service base URL (useful for a local proxy)
# POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
# POLYMARKET_CLOB_URL=https://clob.polymarket.com
# POLYMARKET_DATA_URL=https://data-api.polymarket.com

# Web search for researching real-world events behind markets
# TAVILY_API_KEY=your-tavily-api-key

# Local LLM via Ollama (use /model in the TUI to switch)
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Anonymous usage telemetry (default: enabled). Set to false to disable.
# TELEMETRY_ENABLED=true
